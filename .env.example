# Where all live state is written (leads, sources, fast-lane, deliveries, client workspaces). Default: ./data/studio
STUDIO_DATA_DIR=
# Freelancer OAuth token for bidding, messages and milestones. Optional: on macOS the token can live in the
# login keychain instead (node scripts/studio-fast-lane.mjs set-token). Discovery needs no token.
FREELANCER_OAUTH_TOKEN=
# Where ping JSON files are written for a notifier to pick up. Default: $STUDIO_DATA_DIR/outbox
STUDIO_PING_OUTBOX=
# Path to the Claude Code CLI used for drafting, analysis and production. Default: ~/.local/bin/claude
STUDIO_CLAUDE_BIN=
# Freelancer profile the proposal drafter may claim from. Default: ./config/persona.md
STUDIO_PERSONA_FILE=

# --- web/ (Next.js UI excerpt) ---
# Shared secret for the dashboard API (cookie studio_key or header x-studio-key).
STUDIO_KEY=
# Optional: only used by the account-readiness panel to report Stripe charges/payouts status.
STRIPE_SECRET_KEY=
# Base URL for the Playwright QA scripts in web/qa/.
STUDIO_QA_URL=
